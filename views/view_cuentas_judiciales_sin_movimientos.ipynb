    "%sql\n",
    "CREATE OR REPLACE VIEW cobranzas.semantic.vw_cuentas_judiciales_sin_movimientos AS\n",
    "select count(*) \n",
    "from cobranzas.gold.fact_gestion_judicial_cuenta\n",
    "where month(fecha_ultimo_movimiento_judicial)  not in (8,9,7)\n",
    "and year(fecha_ultimo_movimiento_judicial) == year(current_date)"
   ]
  }
